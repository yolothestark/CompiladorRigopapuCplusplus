{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ejecutar Analizador (Windows)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\AnalizadorLexicoCPP.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Habilitar la impresión con formato para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "compilar"
        }
    ]
}
