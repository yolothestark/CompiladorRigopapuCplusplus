{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe compilar proyecto",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}\\AnalizadorLexicoCPP.exe",
                "${workspaceFolder}\\AnalizadorLexicoCPP\\AnalizadorLexicoCPP\\*.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila todos los archivos .cpp usando el compilador de Visual Studio (cl.exe)."
        }
    ]
}
