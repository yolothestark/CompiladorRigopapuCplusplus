================================================================================
  ARCHIVO EJECUTABLE GENERADO - COMPILADOR RIGOPAPU C++
================================================================================
[CABECERA DEL EJECUTABLE (HEADER)]
  Magic Number    : 7F 52 50 45 (RPE - RigoPapu Executable)
  Arquitectura    : RigoPapu-32 RISC Processor (32-bit)
  Entry Point (PC): 0x1000
  Segmento .text  : 0x1000 (56 bytes) [r-x (Lectura y Ejecucion)]
  Segmento .data  : 0x2000 (24 bytes) [rw- (Lectura y Escritura)]
  Segmento .result: 0x3000 [rw- (Lectura y Escritura)]

[TABLA DE SIMBOLOS Y DIRECCIONES]
  a              -> 0x2000 (.data, Variable)
  b              -> 0x2004 (.data, Variable)
  c              -> 0x2008 (.data, Variable)
  suma           -> 0x200C (.data, Variable)
  producto       -> 0x2010 (.data, Variable)
  result         -> 0x3000 (.result, Resultado)
  L_CALCULO_FINAL -> 0x102C (.text, Etiqueta)

[SEGMENTO DE CODIGO MAQUINA (.text)]
  0x1000 | 0x0111000C | LOAD R1, 12              # Carguen el valor de 12 en el registro R1
  0x1004 | 0x02102000 | STORE 0x2000, R1         # Almacenen el resultado en la variable a
  0x1008 | 0x01110008 | LOAD R1, 8               # Carguen el valor de 8 en el registro R1
  0x100C | 0x02102004 | STORE 0x2004, R1         # Almacenen el resultado en la variable b
  0x1010 | 0x01110004 | LOAD R1, 4               # Carguen el valor de 4 en el registro R1
  0x1014 | 0x02102008 | STORE 0x2008, R1         # Almacenen el resultado en la variable c
  0x1018 | 0x01102000 | LOAD R1, 0x2000          # Carguen el valor de a en el registro R1
  0x101C | 0x10102004 | ADD R1, 0x2004           # Sumen el valor de b al registro R1
  0x1020 | 0x0210200C | STORE 0x200C, R1         # Almacenen el resultado en la variable suma
  0x1024 | 0x12102008 | MUL R1, 0x2008           # Multipliquen el valor en R1 por c
  0x1028 | 0x02102010 | STORE 0x2010, R1         # Almacenen el resultado en la variable producto
  0x102C | 0x01102010 | LOAD R1, 0x2010          # Carguen el valor de producto en el registro R1
  0x1030 | 0x1111000A | SUB R1, 10               # Resten el valor de 10 al registro R1
  0x1034 | 0x02103000 | STORE 0x3000, R1         # Almacenen el resultado en la variable result
